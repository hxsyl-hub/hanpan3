# 忽略所有 Python 编译的缓存文件
*.pyc
*.pyo
__pycache__/

# 忽略数据集（体积大，已单独备份到 D:\python\备份_hanpan3_*）
/data/

# 忽略自己的运行结果（旧 runs/ 已归档到备份目录）
/outputs/
# 增强实验各自的输出目录（outputs_hist / outputs_flip / outputs_pretrained ...）
/outputs_*/

# 训练产出的权重与曲线
*.pth
*.pt
*.onnx
*.ckpt
*.png
*.jpg

# 忽略 Office 临时锁文件（用 Word/Excel 打开文档时会自动生成 ~$xxx）
~$*

/.idea/

# ---------------- 本项目的例外规则 ----------------
# 上面的通用规则会误伤需要留痕的材料，单独放行（! 规则须写在后面才生效）

# 划分清单：记录每张图归哪个集合，是复现实验的依据，必须入库
!/splits/*.txt
!/splits/*.json

# 文档里的图片与统计表属于"有据可查"材料，放行
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.csv

# 清洗报告已移入 docs/（md 本身不在忽略列表内，无需额外放行）
logs/

